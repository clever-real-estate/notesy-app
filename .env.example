# Copy to .env for local development. Do not commit real secrets.
DJANGO_SECRET_KEY=change-me-for-local-development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Local Docker/Postgres uses this shape.
DATABASE_URL=postgres://notesy:notesy_dev_pw@localhost:5432/notesy

# Production deployments should enable these behind HTTPS/proxy termination.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_USE_X_FORWARDED_PROTO=False

# Placeholder only; real API keys should come from a secret manager or CI/CD secrets.
SUMMARIZER_API_KEY=
SUMMARIZER_URL=https://api.summarize.example.com/v1
