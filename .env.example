# Copy to .env and fill in real values. Never commit .env.
# Generate a key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-generate-a-real-key

# Leave False in production. Only set True for local dev.
DJANGO_DEBUG=False

# Comma-separated hostnames the app will serve (e.g. notesy.example.com,localhost,127.0.0.1)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres in prod; omit to fall back to local SQLite for dev.
DATABASE_URL=postgres://notesy:CHANGE_ME@localhost:5432/notesy

# Summarization service. Rotate the key if it has ever been committed.
SUMMARIZER_API_KEY=replace-me
SUMMARIZER_URL=https://api.summarize.example.com/v1
