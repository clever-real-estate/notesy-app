{
  "name": "notesy-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "copy:vendor": "node -e \"require('fs').mkdirSync('static/js',{recursive:true});require('fs').copyFileSync('node_modules/htmx.org/dist/htmx.min.js','static/js/htmx.min.js')\"",
    "dev": "npm run copy:vendor && esbuild apps/notes/static_src/*.ts --bundle --outdir=static/js --watch --sourcemap",
    "build": "npm run copy:vendor && esbuild apps/notes/static_src/*.ts --bundle --outdir=static/js --minify",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "htmx.org": "^1.9.12"
  }
}
