DJANGO_SECRET_KEY=<set-in-secret-manager-or-github-environment-secret>
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=<your-production-hostname>
DATABASE_URL=<managed-postgres-url>
SUMMARIZER_API_KEY=<set-in-secret-manager-or-github-environment-secret>
SUMMARIZER_URL=https://api.summarize.example.com/v1
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_LOG_LEVEL=INFO